# SSH / cert / private key files (security)
*.pem
*.ppk
privvy*

# Node.js (we'll use this when integrating Virtuals acp-cli + dgclaw-skill)
node_modules/

# Git worktrees
.worktrees/

# Temp output dirs
tmp/
temp_vision_images/

# Local CLI config (may contain sensitive SSH paths)
cli-config.yaml

# Hermes Skills Hub local state (lives in ~/.hermes/skills/.hub/ at runtime,
